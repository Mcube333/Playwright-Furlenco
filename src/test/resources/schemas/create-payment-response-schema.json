{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "data"],
  "properties": {
    "success": { "type": "boolean" },
    "data": {
      "type": "object",
      "required": ["payment"],
      "properties": {
        "payment": {
          "type": "object",
          "required": ["id", "status"],
          "properties": {
            "id": { "type": "integer" },
            "status": { "type": "string" },
            "amount": { "type": "string" },
            "currency": { "type": "string" }
          }
        }
      }
    }
  }
}
