{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "data"],
  "properties": {
    "success": { "type": "boolean" },
    "data": {
      "type": "object",
      "required": ["eventId", "questions"],
      "properties": {
        "eventId": { "type": "integer" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "questionStatement", "questionType", "options"],
            "properties": {
              "id": { "type": "integer" },
              "questionStatement": { "type": "string" },
              "questionType": { "type": "string" },
              "isRequired": { "type": "boolean" },
              "isActive": { "type": "boolean" },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "option"],
                  "properties": {
                    "id": { "type": "integer" },
                    "option": { "type": "string" },
                    "isActive": { "type": "boolean" },
                    "category": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
