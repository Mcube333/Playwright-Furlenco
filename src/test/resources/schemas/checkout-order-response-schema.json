{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "data"],
  "properties": {
    "success": { "type": "boolean" },
    "data": {
      "type": "object",
      "required": ["order"],
      "properties": {
        "message": { "type": "string" },
        "order": {
          "type": "object",
          "required": ["id", "orders"],
          "properties": {
            "id": { "type": "integer" },
            "cartId": { "type": "integer" },
            "orders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["displayId"],
                "properties": {
                  "displayId": { "type": "string" },
                  "id": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    }
  }
}
