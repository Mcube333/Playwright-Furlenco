<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Furlenco Web Automation Suite" parallel="none">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.RetryTransformer"/>
    </listeners>

    <test name="Furlenco Web Flows">
        <classes>
            <class name="com.tests.web.furlenco.FurlencoHomePageTest"/>
            <class name="com.tests.web.furlenco.FurlencoSearchAndBrowseTest"/>
            <class name="com.tests.web.furlenco.FurlencoCartFlowTest"/>
            <class name="com.tests.web.furlenco.FurlencoLoginTest"/>
            <class name="com.tests.web.furlenco.FurlencoPlpNavigationTest"/>
            <class name="com.tests.web.furlenco.FurlencoPdpNavigationTest"/>
            <class name="com.tests.web.furlenco.FurlencoCheckoutFlowTest"/>
            <class name="com.tests.web.furlenco.FurlencoB2BSmokeTest"/>
            <class name="com.tests.web.furlenco.FurlencoCartRenderingTest"/>
            <class name="com.tests.web.furlenco.FurlencoCartQuantityAndPersistenceTest"/>
            <class name="com.tests.web.furlenco.FurlencoCartTenureSelectionTest"/>
            <class name="com.tests.web.furlenco.FurlencoCartVasTest"/>
            <class name="com.tests.web.furlenco.FurlencoCartCouponTest"/>
            <class name="com.tests.web.furlenco.FurlencoCartEmptyStateTest"/>
        </classes>
    </test>

</suite>
